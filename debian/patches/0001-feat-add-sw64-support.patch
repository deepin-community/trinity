From 207fdf68497539dfcc7f477d933cf0e5c69643e7 Mon Sep 17 00:00:00 2001
From: hudeng <hudeng@deepin.org>
Date: Tue, 9 Sep 2025 05:20:16 +0000
Subject: [PATCH] feat: add sw64 support

---
 Makefile                 |   1 +
 include/arch-sw_64.h     |  18 ++
 include/arch-syscalls.h  |   3 +
 include/arch.h           |   4 +
 include/syscalls-sw_64.h | 531 +++++++++++++++++++++++++++++++++++++++
 5 files changed, 557 insertions(+)
 create mode 100644 include/arch-sw_64.h
 create mode 100644 include/syscalls-sw_64.h

diff --git a/Makefile b/Makefile
index 88520a9..09d2c3d 100644
--- a/Makefile
+++ b/Makefile
@@ -72,6 +72,7 @@ SYSCALLS_ARCH	:= $(shell case "$(MACHINE)" in \
 		   (i?86*) echo syscalls/x86/*.c \
 				syscalls/x86/i386/*.c;; \
 		   (s390x*) echo syscalls/s390x/*.c ;; \
+		   (sw_64*) echo "" ;; \
 		   esac)
 
 VERSION_H	:= include/version.h
diff --git a/include/arch-sw_64.h b/include/arch-sw_64.h
new file mode 100644
index 0000000..7016352
--- /dev/null
+++ b/include/arch-sw_64.h
@@ -0,0 +1,18 @@
+#pragma once
+
+#define KERNEL_ADDR		0xfffff00000000000UL
+
+#define PAGE_SHIFT		13
+
+#define PAGE_OFFSET		0xfffff00000000000UL
+
+#define TASK_SIZE		0xfffff00000000000UL
+
+#define PTE_FILE_MAX_BITS	35
+
+#define PTRACE_GETREGS		0
+#define PTRACE_GETFPREGS	0
+#define PTRACE_SETREGS		0
+#define PTRACE_SETFPREGS	0
+
+#define SYSCALLS syscalls_sw_64
diff --git a/include/arch-syscalls.h b/include/arch-syscalls.h
index 256bb6b..9ce630d 100644
--- a/include/arch-syscalls.h
+++ b/include/arch-syscalls.h
@@ -31,6 +31,9 @@
 #ifdef __sh__
 #include "syscalls-sh.h"
 #endif
+#ifdef __sw_64__
+#include "syscalls-sw_64.h"
+#endif
 #ifdef __alpha__
 #include "syscalls-alpha.h"
 #endif
diff --git a/include/arch.h b/include/arch.h
index 9bf83a4..7a47344 100644
--- a/include/arch.h
+++ b/include/arch.h
@@ -38,6 +38,10 @@
 #include "arch-sh.h"
 #endif
 
+#ifdef __sw_64__
+#include "arch-sw_64.h"
+#endif
+
 #ifdef __alpha__
 #include "arch-alpha.h"
 #endif
